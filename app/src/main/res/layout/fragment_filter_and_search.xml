<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/sign_in_bg"
    android:padding="20dp"
    tools:context=".FilterAndSearch.FilterAndSearchFragment">

    <ImageButton
        android:id="@+id/btnBack"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:contentDescription="null"
        android:background="@drawable/cancel_btn"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/black" />

    <TextView
        android:id="@+id/txtTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Set Filters"
        android:textColor="@color/black_white"
        android:textSize="20sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/btnBack"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/btnBack" />

    <TextView
        android:id="@+id/lblCategory"
        style="@style/FilterLabelStyle"
        android:text="Category"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btnBack"
        android:layout_marginTop="30dp"/>

    <EditText
        android:id="@+id/etCategory"
        style="@style/FilterInputStyle2"
        android:drawableStart="@drawable/ic_wallet_resized"
        android:drawableEnd="@drawable/arrow_down_resized"
        android:hint="Choose your category"
        android:inputType="text"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/lblCategory" />

    <TextView
        android:id="@+id/lblLocation"
        style="@style/FilterLabelStyle"
        android:text="Location"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/etCategory"
        android:layout_marginTop="20dp"/>

    <EditText
        android:id="@+id/etLocation"
        style="@style/FilterInputStyle"
        android:drawableStart="@drawable/location_resized"
        android:hint="Write your location"
        android:inputType="text"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/lblLocation" />

    <TextView
        android:id="@+id/lblMinSalary"
        style="@style/FilterLabelStyle"
        android:text="Min. Salary"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/etLocation"
        android:layout_marginTop="20dp"/>

    <TextView
        android:id="@+id/lblMaxSalary"
        style="@style/FilterLabelStyle"
        android:text="Max. Salary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/lblMinSalary"/>


    <com.google.android.material.slider.RangeSlider
        android:id="@+id/salarySlider"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:valueFrom="10"
        android:valueTo="300"
        app:values="@array/initial_slider_values"
        app:thumbColor="#FFBB33"
        app:trackColorActive="#FFBB33"
        app:trackColorInactive="#E2E8F0"
        app:layout_constraintTop_toBottomOf="@id/lblMinSalary"
        android:layout_marginTop="15dp"/>

    <TextView
        android:id="@+id/txtSalaryRangeValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="$10K - $300K"
        android:textColor="@color/black_white"
        android:textSize="15sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/salarySlider"
        android:layout_marginTop="5dp"/>

    <TextView
        android:id="@+id/lblJobType"
        style="@style/FilterLabelStyle"
        android:text="Job Type"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/txtSalaryRangeValue"
        android:layout_marginTop="10dp"/>

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/chipGroupJobType"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:chipSpacing="8dp"
        app:layout_constraintTop_toBottomOf="@id/lblJobType"
        android:layout_marginTop="10dp">

        <com.google.android.material.chip.Chip
            style="@style/CustomChipStyle"
            android:text="Company" />
        <com.google.android.material.chip.Chip
            style="@style/CustomChipStyle"
            android:text="Contract Based" />
        <com.google.android.material.chip.Chip
            style="@style/CustomChipStyle"
            android:text="Freelance" />
        <com.google.android.material.chip.Chip
            style="@style/CustomChipStyle"
            android:text="Full Time" />
        <com.google.android.material.chip.Chip
            style="@style/CustomChipStyle"
            android:text="Part Time" />
    </com.google.android.material.chip.ChipGroup>

    <Button
        android:id="@+id/btnApplyFilter"
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:text="Apply Filter"
        android:textAllCaps="false"
        android:textSize="18sp"
        android:backgroundTint="#2969fb"
        app:cornerRadius="20dp"
        android:textColor="@color/white"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginBottom="10dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>